# ============================================================
# CORS — orígenes que pueden consumir la API desde el navegador.
# En local basta con dejarlo comentado. En producción hay que poner
# aquí la URL del frontend desplegado (varias separadas por coma),
# o el navegador bloqueará todas las peticiones.
# ============================================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================
# ASISTENTE VIRTUAL (IA)
# ------------------------------------------------------------
# Proveedor principal: Groq — capa gratuita permanente, sin tarjeta.
#   1. Entra a https://console.groq.com y crea la cuenta (correo o Google).
#   2. Ve a "API Keys" (https://console.groq.com/keys) y pulsa "Create API Key".
#   3. Copia la clave (empieza por gsk_...) y pégala aquí. Solo se muestra una vez.
# Modelos recomendados: openai/gpt-oss-20b  (rápido y con el cupo diario más alto)
#                       openai/gpt-oss-120b (más capaz, algo menos de cupo)
# Para ver los modelos de TU cuenta: https://console.groq.com/docs/models
# ============================================================
GROQ_API_KEY=gsk_tu_clave_de_groq
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Proveedor secundario OPCIONAL. Si Groq alcanza su límite por minuto,
# el asistente reintenta aquí (también con IA real, nunca texto enlatado).
# Clave gratuita en https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
